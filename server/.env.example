# Runtime
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173,http://127.0.0.1:5173
SERVER_URL=http://localhost:5000
VERCEL_PREVIEW_ORIGINS_ENABLED=false

# Database
MONGODB_URI=

# Authentication and security
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=proofarena_refresh
REFRESH_COOKIE_SAME_SITE=lax
JSON_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
CONTACT_RATE_LIMIT_MAX=5
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI foundation
OPENAI_API_KEY=
OPENAI_MODEL=

# Email foundation
EMAIL_ENABLED=false
EMAIL_FROM=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
LEAD_NOTIFICATION_EMAIL=

# Local development fallback:
# When EMAIL_ENABLED=false in development, verification/reset emails are written to
# server/tmp/email-outbox and auth pages can show a development-only link.
# Production must configure a real SMTP provider.

# Stripe billing and marketplace payments
STRIPE_BILLING_ENABLED=false
STRIPE_MARKETPLACE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=
STRIPE_CONNECT_COUNTRY=US
STRIPE_MARKETPLACE_COMMISSION_BPS=1000

# Cloudinary file storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=scaleops

# Queues and local uploads
QUEUE_DRIVER=memory
QUEUE_CONCURRENCY=2
REDIS_URL=
UPLOAD_DIR=
